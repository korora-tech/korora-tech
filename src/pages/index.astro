---
import "../styles/global.css";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Korora Tech builds focused software for Linux desktops. Explore our projects.">
  <meta name="theme-color" content="#f3f2e9">
  <title>Korora Tech — Thoughtful tools for Linux</title>
  <link rel="canonical" href="https://korora.tech/">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
  <header class="site-header wrap">
    <a class="brand" href="#top" aria-label="Korora Tech home"><span class="brand-mark" aria-hidden="true">k<span>.</span></span><span>korora<span class="brand-light">.tech</span></span></a>
    <nav aria-label="Main navigation"><a href="#projects">Projects</a><a href="#about">About</a><a class="nav-github" href="https://github.com/korora-tech">GitHub <span aria-hidden="true">↗</span></a></nav>
  </header>

  <main id="top">
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> SOFTWARE FOR THE LINUX DESKTOP</p>
        <h1 id="hero-title">Small tools.<br><em>More room</em><br>to think.</h1>
        <p class="hero-description">We make focused, native software for the things you do every day. Built for Linux, made to feel at home on your desktop.</p>
        <a class="button" href="#projects">Explore our projects <span aria-hidden="true">↘</span></a>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="art-cross cross-one">✳</div><div class="art-cross cross-two">✳</div>
        <div class="penguin"><div class="penguin-body"><div class="penguin-belly"></div><div class="penguin-eye eye-left"></div><div class="penguin-eye eye-right"></div><div class="penguin-beak"></div></div><div class="penguin-foot foot-left"></div><div class="penguin-foot foot-right"></div></div>
        <span class="art-label">A LITTLE BLUE PENGUIN<br>WITH BIG IDEAS.</span>
        <span class="art-index">K / 01</span>
      </div>
    </section>

    <section class="projects-section" id="projects" aria-labelledby="projects-title">
      <div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">THE KORORA COLLECTION <span> / 01</span></p><h2 id="projects-title">Meet the projects<span class="accent">.</span></h2></div><p>Practical software, each with a job to do.<br>Find the one that fits your workflow.</p></div>
        <div class="project-list">
          <article class="project"><span class="project-number">01</span><span class="project-icon icon-calendar" aria-hidden="true">▦</span><span class="project-main"><span class="project-name">Antarctical</span><span class="project-description">Your Google Calendar, right on your Linux desktop.</span></span><span class="project-category">CALENDAR</span><div class="project-links" aria-label="Antarctical links"><a href="https://antarctical.korora.tech" aria-label="Antarctical website">Website <span aria-hidden="true">↗</span></a><a href="https://github.com/korora-tech/antarctical" aria-label="Antarctical source code">Source <span aria-hidden="true">↗</span></a></div></article>
          <article class="project"><span class="project-number">02</span><span class="project-icon icon-record" aria-hidden="true">●</span><span class="project-main"><span class="project-name">Chinstrap</span><span class="project-description">A recording studio for your screen, camera, and microphone.</span></span><span class="project-category">RECORDING</span><div class="project-links" aria-label="Chinstrap links"><a href="https://chinstrap.korora.tech" aria-label="Chinstrap website">Website <span aria-hidden="true">↗</span></a><a href="https://github.com/korora-tech/chinstrap" aria-label="Chinstrap source code">Source <span aria-hidden="true">↗</span></a></div></article>
          <article class="project"><span class="project-number">03</span><span class="project-icon icon-mail" aria-hidden="true">✳</span><span class="project-main"><span class="project-name">Eloquawk</span><span class="project-description">A native Gmail client for Linux.</span></span><span class="project-category">EMAIL</span><div class="project-links" aria-label="Eloquawk links"><a href="https://eloquawk.korora.tech" aria-label="Eloquawk website">Website <span aria-hidden="true">↗</span></a><a href="https://github.com/korora-tech/eloquawk" aria-label="Eloquawk source code">Source <span aria-hidden="true">↗</span></a></div></article>
          <article class="project"><span class="project-number">04</span><span class="project-icon icon-link" aria-hidden="true">↗</span><span class="project-main"><span class="project-name">Flipper</span><span class="project-description">Send links to the right browser and profile.</span></span><span class="project-category">BROWSING</span><div class="project-links" aria-label="Flipper links"><a href="https://flipper.korora.tech" aria-label="Flipper website">Website <span aria-hidden="true">↗</span></a><a href="https://github.com/korora-tech/flipper" aria-label="Flipper source code">Source <span aria-hidden="true">↗</span></a></div></article>
          <article class="project"><span class="project-number">05</span><span class="project-icon icon-launch" aria-hidden="true">⌘</span><span class="project-main"><span class="project-name">Rockhopper</span><span class="project-description">A Wayland launcher for apps, windows, and commands.</span></span><span class="project-category">LAUNCHER</span><div class="project-links" aria-label="Rockhopper links"><a href="https://rockhopper.korora.tech" aria-label="Rockhopper website">Website <span aria-hidden="true">↗</span></a><a href="https://github.com/korora-tech/rockhopper" aria-label="Rockhopper source code">Source <span aria-hidden="true">↗</span></a></div></article>
        </div>
        <div class="projects-footer"><span>MADE FOR YOUR DESKTOP, WITH CARE.</span><a href="https://github.com/orgs/korora-tech/repositories">All repositories on GitHub <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="about wrap" id="about" aria-labelledby="about-title"><div><p class="eyebrow">A LITTLE ABOUT US <span> / 02</span></p><h2 id="about-title">Good tools should<br><em>get out of the way.</em></h2></div><div class="about-copy"><p>Korora Tech is a small team building focused software for Linux desktops. We like tools that do their job well and give you more space to do yours.</p><a class="text-link" href="https://github.com/korora-tech">Find us on GitHub <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <footer class="site-footer"><div class="wrap footer-inner"><a class="brand footer-brand" href="#top"><span class="brand-mark" aria-hidden="true">k<span>.</span></span><span>korora<span class="brand-light">.tech</span></span></a><p>Thoughtful tools for the Linux desktop.</p><a href="https://github.com/korora-tech">GITHUB ↗</a></div></footer>
</body>
</html>
